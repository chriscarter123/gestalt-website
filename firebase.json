{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/about.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/careers.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/for-visitors.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/how-it-works.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/case-studies.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/documentation.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/api-reference.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/ar-engine.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/security.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/institutions",
        "destination": "/institution/",
        "type": 301
      },
      {
        "source": "/institutions/**",
        "destination": "/institution/:splat",
        "type": 301
      },
      {
        "source": "/website",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/website/**",
        "destination": "/:splat",
        "type": 301
      },
      {
        "source": "/m/:path*",
        "destination": "https://mural.gestalt.gallery/m/:path",
        "type": 301
      },
      {
        "source": "/journey.html",
        "destination": "https://mural.gestalt.gallery/nearby",
        "type": 301
      },
      {
        "source": "/designphilly/",
        "destination": "/designphilly",
        "type": 301
      },
      {
        "source": "/nearby",
        "destination": "https://mural.gestalt.gallery/nearby",
        "type": 301
      },
      {
        "source": "/saved",
        "destination": "https://mural.gestalt.gallery/saved",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/scorecard",
        "destination": "/scorecard.html"
      },
      {
        "source": "/designphilly",
        "destination": "/designphilly.html"
      },
      {
        "source": "/nyc",
        "destination": "/nyc.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/institution/**",
        "destination": "/institution/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "upgrade-insecure-requests; block-all-mixed-content"
          }
        ]
      }
    ]
  }
}
